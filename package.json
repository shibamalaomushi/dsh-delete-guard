{
  "name": "dsh-delete-guard",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "受控删除与回收站：默认移入可还原的回收站，提供 11 项服务端强制的删除策略、分级安全确认与全程审计日志；支持批量删除、多入口（面板/会话行/斜杠命令）与活跃会话保护。适配 DeepSeek Harness 0.2.1-rc.2。 | Guarded session deletion for DSH: recoverable trash, server-enforced deletion policy, graded confirmation, audit log with rotation, batch actions and live-session protection. Compatible with DSH 0.2.1-rc.2.",
  "author": "shibamalaomushi",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "session",
    "session-manager",
    "trash",
    "recycle-bin",
    "safe-delete",
    "delete-policy",
    "audit"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shibamalaomushi/dsh-delete-guard.git"
  },
  "homepage": "https://github.com/shibamalaomushi/dsh-delete-guard#readme",
  "bugs": {
    "url": "https://github.com/shibamalaomushi/dsh-delete-guard/issues"
  },
  "scripts": {
    "test": "node test/selftest.mjs && node test/paths.mjs && node test/audit.mjs . && node test/sensitive-scan.mjs ."
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT"
}
